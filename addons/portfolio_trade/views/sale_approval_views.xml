<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_approval" model="ir.ui.view">
        <field name="name">sale.order.form.portfolio.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="portfolio_approval_enabled" invisible="1"/>
                <field name="portfolio_approval_current" invisible="1"/>
                <button name="action_portfolio_submit" type="object" string="Submit for Approval"
                        invisible="not portfolio_approval_enabled or state not in ('draft', 'sent') or (portfolio_approval_state == 'submitted' and portfolio_approval_current)"/>
                <button name="action_portfolio_approve" type="object" string="Approve"
                        groups="sales_team.group_sale_manager"
                        invisible="not portfolio_approval_enabled or not portfolio_approval_current or portfolio_approval_state != 'submitted' or state not in ('draft', 'sent')"/>
                <button name="action_portfolio_reject_wizard" type="object" string="Reject"
                        groups="sales_team.group_sale_manager"
                        invisible="not portfolio_approval_enabled or not portfolio_approval_current or portfolio_approval_state != 'submitted' or state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Sales Approval" name="portfolio_approval" invisible="not portfolio_approval_enabled">
                    <div class="alert alert-warning" invisible="portfolio_approval_current or portfolio_approval_state not in ('submitted', 'approved')">
                        Company policy changed. Submit this quotation again before approval or confirmation.
                    </div>
                    <group>
                        <field name="portfolio_approval_state"/>
                        <field name="portfolio_approval_submitter_id"/>
                        <field name="portfolio_approval_policy_version"/>
                    </group>
                    <field name="portfolio_approval_history_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="occurred_at"/>
                            <field name="event"/>
                            <field name="actor_id"/>
                            <field name="policy_version"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="sale_order_form_provenance" model="ir.ui.view">
        <field name="name">sale.order.form.portfolio.provenance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="portfolio_purchase_ids" invisible="1" groups="purchase.group_purchase_user"/>
                <button name="action_portfolio_purchases" type="object" class="oe_stat_button"
                        icon="fa-shopping-cart" groups="purchase.group_purchase_user"
                        invisible="not portfolio_purchase_ids">
                    <div class="o_stat_info"><span class="o_stat_text">Related Purchases</span></div>
                </button>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_form_provenance" model="ir.ui.view">
        <field name="name">purchase.order.form.portfolio.provenance</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="portfolio_source_sale_id" readonly="state in ('to approve', 'purchase', 'done')"
                       domain="[('company_id', '=', company_id), ('state', '=', 'sale')]"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="company_form_approval" model="ir.ui.view">
        <field name="name">res.company.form.portfolio.approval</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Order Fulfillment Policy" groups="base.group_system">
                    <group>
                        <field name="portfolio_fulfillment_enabled"/>
                    </group>
                    <p>Apply company fulfillment controls to standard orders and API entries.
                    Purchase sources remain informational and do not reserve stock.</p>
                </page>
                <page string="Industrial Parts Master Data" groups="base.group_system">
                    <group>
                        <field name="portfolio_masterdata_enabled"/>
                    </group>
                    <p>Validate customer and vendor references, product SKUs, units and stock supplier data
                    when submitting or confirming sales and confirming purchases.</p>
                </page>
                <page string="Sales Approval Policy" groups="base.group_system">
                    <group>
                        <field name="portfolio_approval_enabled"/>
                        <field name="portfolio_approval_amount"/>
                        <field name="portfolio_approval_discount"/>
                        <field name="portfolio_approval_policy_version"/>
                    </group>
                    <p>Applies to every quotation in this company, including standard Sales and API entries.
                    Amounts use the company currency. Commercial changes require a new approval.</p>
                </page>
            </xpath>
        </field>
    </record>
    <record id="sale_approval_reject_form" model="ir.ui.view">
        <field name="name">portfolio.sale.approval.reject.form</field>
        <field name="model">portfolio.sale.approval.reject</field>
        <field name="arch" type="xml">
            <form string="Reject quotation">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="reason" placeholder="Explain what needs to change"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

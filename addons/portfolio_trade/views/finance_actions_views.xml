<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_finance" model="ir.ui.view">
        <field name="name">sale.order.form.portfolio.finance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_portfolio_trace" type="object" string="Fulfillment Trace"
                        groups="sales_team.group_sale_salesman,purchase.group_purchase_user,account.group_account_invoice"/>
                <field name="portfolio_finance_enabled" invisible="1" groups="account.group_account_invoice"/>
                <button name="action_portfolio_create_invoice" type="object" string="Prepare Customer Invoice"
                        groups="account.group_account_invoice"
                        invisible="not portfolio_finance_enabled or state != 'sale' or invoice_status != 'to invoice'"/>
            </xpath>
        </field>
    </record>
    <record id="invoice_form_partial_credit" model="ir.ui.view">
        <field name="name">account.move.form.portfolio.partial.credit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="portfolio_finance_enabled" invisible="1" groups="account.group_account_invoice"/>
                <button name="action_portfolio_partial_credit" type="object" string="Partial Customer Credit"
                        groups="account.group_account_invoice"
                        invisible="not portfolio_finance_enabled or state != 'posted' or move_type != 'out_invoice'"/>
            </xpath>
        </field>
    </record>
    <record id="partial_credit_form" model="ir.ui.view">
        <field name="name">portfolio.partial.credit.form</field>
        <field name="model">portfolio.partial.credit</field>
        <field name="arch" type="xml">
            <form string="Partial customer credit">
                <group>
                    <field name="original_line_id" options="{'no_create': True}"
                           domain="[('move_id.state', '=', 'posted'), ('move_id.move_type', '=', 'out_invoice'), ('display_type', '=', 'product'), ('sale_line_ids', '!=', False)]"/>
                    <field name="available_quantity" readonly="1"/>
                    <label for="quantity"/>
                    <div class="o_row">
                        <field name="quantity"/>
                        <field name="product_uom_id" readonly="1"/>
                    </div>
                </group>
                <footer>
                    <button name="action_create_credit" type="object" string="Prepare Credit Note" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

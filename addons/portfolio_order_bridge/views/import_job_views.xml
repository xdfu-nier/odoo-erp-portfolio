<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_job_list" model="ir.ui.view">
        <field name="name">portfolio.import.job.list</field>
        <field name="model">portfolio.import.job</field>
        <field name="arch" type="xml">
            <list string="External orders / 外部订单" create="false" edit="false" delete="false"
                  decoration-danger="state == 'failed'" decoration-success="state == 'done'">
                <header>
                    <button name="action_process_pending" type="object" display="always"
                            string="Process pending / 处理待办" class="btn-primary"
                            groups="portfolio_order_bridge.group_import_operator"/>
                </header>
                <field name="state" string="Status / 状态"/>
                <field name="source_id" string="Source / 来源"/>
                <field name="company_id" string="Company / 公司"/>
                <field name="external_order_id" string="External order / 外部单号"/>
                <field name="attempt_count" string="Attempts / 处理次数"/>
                <field name="received_at" string="Received / 接收时间"/>
                <field name="last_attempt_at" string="Last processed / 最近处理"/>
                <field name="error_detail" string="Reason / 处理说明"/>
                <field name="sale_order_id" string="Quotation / 报价单" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_import_job_form" model="ir.ui.view">
        <field name="name">portfolio.import.job.form</field>
        <field name="model">portfolio.import.job</field>
        <field name="arch" type="xml">
            <form string="External order / 外部订单" create="false" edit="false" delete="false" duplicate="false">
                <header>
                    <button name="action_process_pending" type="object" class="btn-primary"
                            string="Process pending / 处理待办" invisible="state != 'pending'"
                            groups="portfolio_order_bridge.group_import_operator"/>
                    <button name="action_open_retry" type="object" class="btn-primary"
                            string="Retry after repair / 修复后重试" invisible="state != 'failed'"
                            groups="portfolio_order_bridge.group_import_operator"/>
                    <button name="action_open_sale_order" type="object"
                            string="Open quotation / 查看报价单" invisible="state != 'done' or not sale_order_id"
                            groups="portfolio_order_bridge.group_import_operator"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="external_order_id" string="External order / 外部单号"/>
                            <field name="source_id" string="Source / 来源"/>
                            <field name="company_id" string="Company / 公司"/>
                            <field name="sale_order_id" string="Quotation / 报价单" options="{'no_open': True}"/>
                        </group>
                        <group>
                            <field name="attempt_count" string="Attempts / 处理次数"/>
                            <field name="received_at" string="Received / 接收时间"/>
                            <field name="last_attempt_at" string="Last processed / 最近处理"/>
                            <field name="submitted_by_id" string="Submitted by / 接入用户"/>
                        </group>
                    </group>
                    <group string="Processing result / 处理结果">
                        <field name="error_code" string="Error / 错误类型"/>
                        <field name="error_detail" string="Reason / 处理说明"/>
                    </group>
                    <notebook>
                        <page string="History / 处理记录" groups="portfolio_order_bridge.group_import_integration,portfolio_order_bridge.group_import_operator">
                            <field name="attempt_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="attempt_no"/>
                                    <field name="event_type"/>
                                    <field name="actor_id"/>
                                    <field name="started_at"/>
                                    <field name="finished_at"/>
                                    <field name="error_path"/>
                                    <field name="error_detail"/>
                                    <field name="retry_reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reception audit / 接收审计" groups="portfolio_order_bridge.group_import_integration,portfolio_order_bridge.group_import_operator">
                            <group>
                                <field name="payload_hash"/>
                                <field name="raw_payload"/>
                                <field name="canonical_payload"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_import_jobs" model="ir.actions.act_window">
        <field name="name">External orders / 外部订单</field>
        <field name="res_model">portfolio.import.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

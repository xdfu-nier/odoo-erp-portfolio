<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_retry_form" model="ir.ui.view">
        <field name="name">portfolio.import.retry.form</field>
        <field name="model">portfolio.import.retry</field>
        <field name="arch" type="xml">
            <form string="Retry import / 重试导入" create="true" delete="false" duplicate="false">
                <group>
                    <field name="job_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                    <field name="company_id" invisible="1"/>
                    <field name="reason" placeholder="Describe the repair before retrying / 请说明已完成的修复"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Retry / 确认重试" class="btn-primary"/>
                    <button string="Cancel / 取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
